<Window x:Class="LockPC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI退烧贴" Icon="Assets/app-header.png" Width="1120" Height="760" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBackground}"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#CFE5E3"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,13"/><Setter Property="Margin" Value="10,3"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#0D2D31">
            <Grid><Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="20,22" VerticalAlignment="Top">
                    <Image Source="Assets/app-header.png" Width="38" Height="38"/>
                    <StackPanel Margin="10,1,0,0"><TextBlock Text="AI退烧贴" Foreground="White" FontSize="17" FontWeight="SemiBold"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource NavButton}" Tag="0" Click="Navigate_Click" Content="⌂  首页"/>
                    <Button Style="{StaticResource NavButton}" Tag="1" Click="Navigate_Click" Content="⏱  专注"/>
                    <Button Style="{StaticResource NavButton}" Tag="2" Click="Navigate_Click" Content="☾  睡眠保护"/>
                    <Button Style="{StaticResource NavButton}" Tag="3" Click="Navigate_Click" Content="▥  数据分析"/>
                    <Button Style="{StaticResource NavButton}" Tag="4" Click="Navigate_Click" Content="⚙  设置"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="20,0,20,22"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#7ED9CE" Margin="0,0,8,0"/><TextBlock x:Name="HeaderStatusText" Text="当前无计划" Foreground="#B9D0CE" FontSize="12" TextWrapping="Wrap"/></StackPanel></StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Column="1" x:Name="MainTabs" Background="Transparent" BorderThickness="0" SelectionChanged="MainTabs_SelectionChanged">
            <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="36" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Text="AI虽顶，别太上头" FontSize="31" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="纵然 AI 风姿千千万，休要给我一双熊猫眼。" Margin="0,10,0,0" FontWeight="Bold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="给被 AI 勾了魂、忘记休息、舍不得睡的赛博人，一张退烧贴。" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="用一张数字退烧贴，管住连续专注、强制离屏与夜间睡眠。" Margin="0,6,0,24" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                    <Border x:Name="CurrentPlanCard" Style="{StaticResource Card}" Background="{StaticResource PrimarySoftBrush}" BorderBrush="#98E7DD" Padding="24">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="58" Height="58" CornerRadius="16" Background="#CBF7F1"><TextBlock Text="⏱" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0D9488"/></Border>
                            <StackPanel Grid.Column="1" Margin="16,0"><TextBlock x:Name="CurrentPlanKicker" Text="当前状态" Foreground="#0F766E" FontSize="12"/><TextBlock x:Name="CurrentPlanTitle" Text="当前没有专注计划" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/><TextBlock x:Name="CurrentPlanSubtitle" Text="今天准备和 AI 专注多久？" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock x:Name="CurrentCountdownText" Text="--:--" FontFamily="Consolas" FontSize="35" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/><Button x:Name="CancelPlanButton" Content="结束本次专注计划" Visibility="Collapsed" Margin="0,8,0,0" Background="#FFF1EC" Foreground="#C2410C" BorderBrush="#FDBA9A" Click="CancelPlan_Click"/></StackPanel>
                        </Grid>
                    </Border>
                    <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}"><StackPanel><TextBlock Text="⏱" FontSize="24" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="专注模式" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="HomeFocusSummary" Text="专注 45 分钟 · 休息 10 分钟 · 4 轮" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,18"/><Button Content="调整计划 →" HorizontalAlignment="Left" Tag="1" Click="Navigate_Click" Background="Transparent" Foreground="{StaticResource PrimaryBrush}" BorderThickness="0"/></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Background="#101B31"><StackPanel><TextBlock Text="☾" FontSize="24" Foreground="#91A9DE"/><TextBlock Text="睡眠保护" FontSize="19" FontWeight="SemiBold" Foreground="White" Margin="0,8,0,0"/><TextBlock x:Name="HomeSleepSummary" Text="今晚 23:30 · 06:00 自动解除" Foreground="#B8C2D8" Margin="0,6,0,18"/><Button Content="演示睡眠保护状态 →" HorizontalAlignment="Left" Click="PreviewSleep_Click" Background="Transparent" Foreground="#62E1D1" BorderThickness="0"/></StackPanel></Border>
                    </Grid>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="36" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock Text="专注计划" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="专注期间正常使用电脑；每轮结束后，退烧贴会覆盖屏幕并要求离屏休息。" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,22"/>
                    <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="专注时长" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/><ComboBox x:Name="FocusMinutesCombo"><ComboBoxItem Content="15 分钟" Tag="15"/><ComboBoxItem Content="25 分钟" Tag="25"/><ComboBoxItem Content="30 分钟" Tag="30"/><ComboBoxItem Content="45 分钟" Tag="45"/><ComboBoxItem Content="50 分钟" Tag="50"/><ComboBoxItem Content="60 分钟" Tag="60"/></ComboBox></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="退烧休息" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/><ComboBox x:Name="RestMinutesCombo"><ComboBoxItem Content="5 分钟" Tag="5"/><ComboBoxItem Content="10 分钟" Tag="10"/><ComboBoxItem Content="15 分钟" Tag="15"/><ComboBoxItem Content="20 分钟" Tag="20"/></ComboBox></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="专注轮数" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/><ComboBox x:Name="RoundsCombo"><ComboBoxItem Content="1 轮" Tag="1"/><ComboBoxItem Content="2 轮" Tag="2"/><ComboBoxItem Content="4 轮" Tag="4"/><ComboBoxItem Content="6 轮" Tag="6"/></ComboBox></StackPanel>
                    </Grid></Border>
                    <Border Style="{StaticResource Card}" Background="{StaticResource PrimarySoftBrush}" BorderBrush="#A7EBDD" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="开始后，专注模式立即生效" FontWeight="SemiBold"/><TextBlock Text="如需结束整组计划，必须填写至少 5 个字的理由。" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="开始专注计划" Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" Click="StartPomodoro_Click"/></Grid></Border>
                    <TextBlock Text="体验界面" FontSize="18" FontWeight="SemiBold" Margin="0,26,0,10"/><StackPanel Orientation="Horizontal"><Button Content="试贴休息模式（10 秒）" Click="PreviewRest_Click"/><Button Content="演示提前撕贴" Margin="10,0,0,0" Click="PreviewPeel_Click"/></StackPanel>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="36" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock Text="睡眠保护" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="到点覆盖所有显示器；保护生效后不可暂停、提前退出或修改计划。" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,22"/>
                    <Border Style="{StaticResource Card}"><StackPanel><CheckBox x:Name="SleepEnabledCheck" Content="启用夜间睡眠保护" FontWeight="SemiBold" Margin="0,0,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="开始时间（HH:mm）" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="SleepStartText" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="解除时间（HH:mm）" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="SleepEndText" Margin="0,7,0,0"/></StackPanel></Grid>
                        <TextBlock Text="生效星期（按开始日计算）" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,10"/><WrapPanel><CheckBox x:Name="MondayCheck" Content="周一" Margin="0,0,16,8"/><CheckBox x:Name="TuesdayCheck" Content="周二" Margin="0,0,16,8"/><CheckBox x:Name="WednesdayCheck" Content="周三" Margin="0,0,16,8"/><CheckBox x:Name="ThursdayCheck" Content="周四" Margin="0,0,16,8"/><CheckBox x:Name="FridayCheck" Content="周五" Margin="0,0,16,8"/><CheckBox x:Name="SaturdayCheck" Content="周六" Margin="0,0,16,8"/><CheckBox x:Name="SundayCheck" Content="周日" Margin="0,0,16,8"/></WrapPanel>
                    </StackPanel></Border>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button Content="保存睡眠保护计划" Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" Click="SaveSleepSettings_Click"/><Button Content="演示睡眠保护状态" Margin="10,0,0,0" Click="PreviewSleep_Click"/></StackPanel>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="36" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Text="数据分析" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="最近 7 天 · 仅根据本机计划、休息、撕贴和睡眠事件汇总。" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,20"/>
                    <UniformGrid Columns="4"><Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="专注时长" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="MetricFocusText" Text="0 分钟" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="MetricRoundsText" Text="0 轮完成" Foreground="{StaticResource PrimaryBrush}"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="完整休息率" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="MetricRestRateText" Text="0%" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="MetricRestCountText" Text="0 次完整休息" Foreground="{StaticResource PrimaryBrush}"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="中断/撕贴" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="MetricInterruptionsText" Text="0 次" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="需填写理由" Foreground="{StaticResource HotBrush}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="睡眠保护" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="MetricSleepText" Text="0 晚" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="MetricDelayText" Text="延迟 0 次" Foreground="#667085"/></StackPanel></Border></UniformGrid>
                    <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="每日完成专注" FontWeight="SemiBold" FontSize="17"/><ItemsControl x:Name="DailyFocusList" Margin="0,14,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Day}" Foreground="{StaticResource MutedBrush}"/><Border Grid.Column="1" Width="{Binding BarWidth}" Height="10" Background="{StaticResource PrimaryBrush}" CornerRadius="5" HorizontalAlignment="Left"/><TextBlock Grid.Column="2" Text="{Binding Minutes, StringFormat={}{0} 分钟}" Margin="8,0,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="中断时段分布" FontWeight="SemiBold" FontSize="17"/><ItemsControl x:Name="InterruptionBucketList" Margin="0,14,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}"/><Border Grid.Column="1" Width="{Binding BarWidth}" Height="10" Background="{StaticResource HotBrush}" CornerRadius="5" HorizontalAlignment="Left"/><TextBlock Grid.Column="2" Text="{Binding Count, StringFormat={}{0} 次}" Margin="8,0,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></Grid>
                    <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="近期记录" FontSize="17" FontWeight="SemiBold"/><ListBox x:Name="ActivityList" BorderThickness="0" Margin="0,10,0,0"><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time}" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding Type}" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="EmptyActivityText" Text="暂无数据，完成一次计划后这里会开始积累。" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/></StackPanel></Border>
                    <Border Background="#EEF3F5" CornerRadius="12" Padding="16" Margin="0,16,0,0"><TextBlock Text="隐私说明：不读取应用名称、网站、窗口标题、键盘输入或屏幕内容；所有统计文件只保存在本机。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></Border>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="36" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock Text="设置" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="应用行为、撕贴反馈与版本信息。" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,22"/>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="应用设置" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="StartWithWindowsCheck" Content="开机自动启动" Margin="0,16,0,0"/><CheckBox x:Name="PeelSoundCheck" Content="确认撕贴后播放短音效" Margin="0,12,0,0"/><Button Content="保存应用设置" HorizontalAlignment="Left" Margin="0,16,0,0" Click="SaveAppSettings_Click"/></StackPanel></Border>
                    <Expander Header="关于与更新" IsExpanded="True" Margin="0,18,0,0"><Border Style="{StaticResource Card}" Margin="0,10,0,0"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="AI退烧贴" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="CurrentVersionText" Text="当前版本 v1.1.1" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdate_Click"/></Grid><TextBlock Text="纵然 AI 风姿千千万，休要给我一双熊猫眼。" Margin="0,18,0,0" FontWeight="SemiBold"/><TextBlock Text="本软件只管理计划与覆盖提示，不识别具体 AI 工具、浏览器、开发工具或任何窗口内容。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/><Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="10" Padding="14" Margin="0,16,0,0"><StackPanel><TextBlock x:Name="UpdateStatusText" Text="尚未检查更新" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/><TextBlock x:Name="UpdateDetailText" Text="可与 GitHub Releases 的最新公开版本比较。" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="DownloadUpdateButton" Content="下载更新" Visibility="Collapsed" Click="DownloadUpdate_Click"/><Button Content="打开 GitHub" Margin="8,0,0,0" Click="OpenGithub_Click"/></StackPanel></StackPanel></Border><TextBlock Text="版本记录" FontWeight="SemiBold" Margin="0,18,0,8"/><ItemsControl x:Name="ReleaseNotesList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Version, StringFormat=v{0}}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Date}" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="2" Text="{Binding Summary}" TextWrapping="Wrap"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></Expander>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
