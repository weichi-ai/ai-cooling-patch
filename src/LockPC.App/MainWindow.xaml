<Window x:Class="LockPC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI退烧贴"
        Icon="Assets/app-header.png"
        Width="940" Height="680"
        MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackground}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/app-header.png" Width="34" Height="34" Stretch="Uniform" />
                    <TextBlock Text="AI退烧贴" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource PrimaryBrush}" Margin="0,0,7,0" />
                    <TextBlock x:Name="HeaderStatusText" Text="当前无计划" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" x:Name="MainTabs" Margin="18" Background="Transparent" BorderThickness="0" SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="首页">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="纵然 AI 风姿千千万，休要给我一双熊猫眼。" FontSize="29" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="给被 AI 勾了魂、忘记休息、舍不得睡的赛博人，一张退烧贴。" Margin="0,8,0,24" Foreground="{StaticResource MutedBrush}" FontSize="14" TextWrapping="Wrap" />

                        <Border x:Name="CurrentPlanCard" Background="{StaticResource PrimarySoftBrush}" CornerRadius="16" Padding="22" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="CurrentPlanTitle" Text="当前没有退烧计划" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock x:Name="CurrentPlanSubtitle" Text="今天准备和 AI 专注多久？" Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock x:Name="CurrentCountdownText" Text="--:--" FontSize="34" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right" />
                                    <Button x:Name="CancelPlanButton" Content="结束本次计划" Visibility="Collapsed" Margin="0,8,0,0" Padding="12,6" Click="CancelPlan_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#E6F1EC" CornerRadius="16" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="专注退烧计划" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock x:Name="HomeFocusSummary" Text="专注 45 分钟 · 强制休息 10 分钟 · 4 轮" Margin="0,8,0,20" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                    <Button Content="配置并开始" HorizontalAlignment="Left" Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" Click="OpenFocusTab_Click" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#F3EEE6" CornerRadius="16" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="睡眠保护" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock x:Name="HomeSleepSummary" Text="今晚 23:30 开始 · 06:00 解除" Margin="0,8,0,20" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                    <Button Content="查看计划" HorizontalAlignment="Left" Click="OpenSleepTab_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="专注">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="今天准备和 AI 专注多久？" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="选好本轮剂量，Token 和人类都别超载。专注期正常使用电脑，每轮结束后强制离屏休息。" Margin="0,8,0,22" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />

                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="专注时长" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/><ComboBox x:Name="FocusMinutesCombo"><ComboBoxItem Content="15 分钟" Tag="15"/><ComboBoxItem Content="25 分钟" Tag="25"/><ComboBoxItem Content="30 分钟" Tag="30"/><ComboBoxItem Content="45 分钟" Tag="45"/><ComboBoxItem Content="50 分钟" Tag="50"/><ComboBoxItem Content="60 分钟" Tag="60"/></ComboBox></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="强制休息" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/><ComboBox x:Name="RestMinutesCombo"><ComboBoxItem Content="5 分钟" Tag="5"/><ComboBoxItem Content="10 分钟" Tag="10"/><ComboBoxItem Content="15 分钟" Tag="15"/><ComboBoxItem Content="20 分钟" Tag="20"/></ComboBox></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="专注轮数" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/><ComboBox x:Name="RoundsCombo"><ComboBoxItem Content="1 轮" Tag="1"/><ComboBoxItem Content="2 轮" Tag="2"/><ComboBoxItem Content="4 轮" Tag="4"/><ComboBoxItem Content="6 轮" Tag="6"/></ComboBox></StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="14" Padding="20">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="开始后可填写理由结束计划" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><TextBlock Text="休息也可填写理由提前撕贴；两类理由均保存在本机。" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                                <Button Grid.Column="1" Content="开始退烧计划" Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" Click="StartPomodoro_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="睡眠保护">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="今晚准备几点和 AI 说晚安？" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="到点自动覆盖屏幕，守住睡眠底线。显示器可以正常息屏，唤醒后保护仍会继续。" Margin="0,8,0,22" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />

                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="SleepEnabledCheck" Content="启用夜间睡眠保护" FontWeight="SemiBold" Margin="0,0,0,18" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="开始时间（HH:mm）" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/><TextBox x:Name="SleepStartText" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="解除时间（HH:mm）" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/><TextBox x:Name="SleepEndText" /></StackPanel>
                                </Grid>
                                <TextBlock Text="生效星期（按开始日计算）" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,10" />
                                <WrapPanel>
                                    <CheckBox x:Name="MondayCheck" Content="周一" Margin="0,0,16,8"/><CheckBox x:Name="TuesdayCheck" Content="周二" Margin="0,0,16,8"/><CheckBox x:Name="WednesdayCheck" Content="周三" Margin="0,0,16,8"/><CheckBox x:Name="ThursdayCheck" Content="周四" Margin="0,0,16,8"/><CheckBox x:Name="FridayCheck" Content="周五" Margin="0,0,16,8"/><CheckBox x:Name="SaturdayCheck" Content="周六" Margin="0,0,16,8"/><CheckBox x:Name="SundayCheck" Content="周日" Margin="0,0,16,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#F3EEE6" CornerRadius="14" Padding="20">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="开始前 30 秒提醒" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><TextBlock Text="每晚可延迟一次：5、10、15 或 30 分钟；结束时间不顺延。" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                                <Button Grid.Column="1" Content="保存夜间退烧计划" Click="SaveSleepSettings_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="上头记录">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="看看哪些时刻最容易撕贴。" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="这里记录提前结束专注或休息的时间和原因，帮助你发现自己的使用规律。记录只保存在本机。" Margin="0,8,0,22" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
                            <Grid>
                                <ListBox x:Name="CancellationList" BorderThickness="0" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,12">
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="{Binding Time}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Type}" Margin="0,4,0,0" Foreground="{StaticResource PrimaryBrush}" FontSize="11"/></StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Reason}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Margin="16,0,0,0" Foreground="{StaticResource MutedBrush}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="EmptyRecordsPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                    <TextBlock Text="暂时没有上头记录。" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="看来这张退烧贴还挺牢。" Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="测试与设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="测试与设置" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="先用短时预览确认多显示器和锁定界面是否符合预期。" Margin="0,8,0,22" Foreground="{StaticResource MutedBrush}" />
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><CheckBox x:Name="StartWithWindowsCheck" Content="登录 Windows 后自动运行 AI退烧贴" FontWeight="SemiBold"/><TextBlock Text="确保重启登录后能恢复正在生效的计划。" Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                                <Button Grid.Column="1" Content="保存启动设置" Click="SaveStartupSetting_Click" />
                            </Grid>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20">
                            <StackPanel>
                                <TextBlock Text="覆盖层试贴" FontWeight="SemiBold" FontSize="17" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="试贴期间会真实阻断键盘和鼠标，并在 10 秒后自动揭下。" Margin="0,7,0,16" Foreground="{StaticResource MutedBrush}" />
                                <WrapPanel><Button Content="试贴休息模式（10 秒）" Click="PreviewRest_Click" Margin="0,0,10,0"/><Button Content="试贴睡眠模式（10 秒）" Click="PreviewSleep_Click" /></WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="AboutTab" Header="关于">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="760" HorizontalAlignment="Left">
                        <Border Background="#101525" CornerRadius="18" Padding="26" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Image Source="Assets/app-header.png" Width="64" Height="64" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="AI退烧贴" FontSize="28" FontWeight="Bold" Foreground="#63E6D2" />
                                    <TextBlock Text="纵然 AI 风姿千千万，休要给我一双熊猫眼。" Margin="0,7,0,0" FontSize="16" Foreground="#F5F7FA" TextWrapping="Wrap" />
                                    <TextBlock Text="给被 AI 勾了魂、忘记休息、舍不得睡的赛博人，一张退烧贴。" Margin="0,9,0,0" Foreground="#B8C2D8" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="UpdateCard" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="版本与更新" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock x:Name="CurrentVersionText" Text="当前版本 v0.0.0" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="UpdateStatusText" Text="正在检查更新…" Margin="0,14,0,0" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                    <TextBlock x:Name="UpdateDetailText" Text="将自动与 GitHub Releases 的最新公开版本比较。" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="500" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="20,0,0,0">
                                    <Button x:Name="DownloadUpdateButton" Content="下载最新版" Visibility="Collapsed" Margin="0,0,0,8" Background="{StaticResource HotBrush}" Foreground="White" BorderThickness="0" Click="DownloadUpdate_Click" />
                                    <Button x:Name="CheckUpdateButton" Content="重新检查" Click="CheckUpdate_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="版本更新记录" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,10" />
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
                            <ItemsControl x:Name="ReleaseNotesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="2,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Version}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Date}" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Summary}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="关闭窗口后 AI退烧贴仍在系统托盘运行。Windows 安全界面和管理员操作不在应用级锁定能力范围内。" Margin="18,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" />
        </Border>
    </Grid>
</Window>
