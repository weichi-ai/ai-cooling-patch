<Window x:Class="LockPC.App.Views.SleepWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="今日 AI 亲密额度即将用完"
        Width="640" Height="548"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#14213D" />
        <SolidColorBrush x:Key="MutedInkBrush" Color="#64748B" />

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#EEF2F5" />
                                <Setter Property="Foreground" Value="#14213D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DelayButton" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Background" Value="#F7FAFC" />
            <Setter Property="Foreground" Value="#24324B" />
            <Setter Property="BorderBrush" Value="#DDE6EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#E9FBF7" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#76DCCB" />
                                <Setter Property="Foreground" Value="#0F766E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#D6F6EF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Background" Value="#F4F6F8" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#E8EDF1" />
                                <Setter Property="Foreground" Value="#A6B0BD" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="Background" Value="#14213D" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#203354" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#0B1328" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Border Background="#FFFFFF" CornerRadius="18" BorderBrush="#D9E2E8" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#1E293B" BlurRadius="28" ShadowDepth="8" Opacity="0.20" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="TitleBar" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                        <Image Source="/LockPC.App;component/Assets/app-header.png" Width="26" Height="26" />
                        <TextBlock Text="AI退烧贴" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#334155" />
                        <Border Margin="10,0,0,0" Padding="8,3" CornerRadius="8" Background="#E9FBF7">
                            <TextBlock Text="睡眠保护" FontSize="11" FontWeight="SemiBold" Foreground="#0F8F80" />
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="×"
                            FontFamily="Segoe UI" FontSize="22" Margin="0,0,14,0"
                            Click="Close_Click" ToolTip="关闭提醒" />
                </Grid>

                <Grid Grid.Row="1" Margin="34,14,34,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="148" />
                        <RowDefinition Height="22" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="52" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="今天先到这里吧" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock x:Name="MessageText" Margin="0,8,0,0" MaxWidth="540"
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedInkBrush}"
                                   FontSize="13.5" LineHeight="22" HorizontalAlignment="Left" />
                    </StackPanel>

                    <Border Grid.Row="2" CornerRadius="16" Background="#14213D" Padding="22,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="距离电脑锁定" Foreground="#9FB0C8" FontSize="12" />
                                    <TextBlock x:Name="CountdownText" Text="00:30" Margin="0,3,0,0"
                                               FontSize="43" FontWeight="SemiBold" FontFamily="Consolas"
                                               Foreground="White" />
                                </StackPanel>
                                <Border Grid.Column="1" VerticalAlignment="Center" Background="#203354"
                                        BorderBrush="#314564" BorderThickness="1" CornerRadius="12" Padding="15,10">
                                    <StackPanel>
                                        <TextBlock Text="自动解除" Foreground="#91A2BA" FontSize="11" />
                                        <TextBlock x:Name="UnlockTimeText" Text="明早 07:00" Margin="0,3,0,0"
                                                   Foreground="#64DFC9" FontSize="14" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <ProgressBar Grid.Row="1" x:Name="CountdownProgress" Height="4" Maximum="30" Value="30"
                                         Margin="0,12,0,0" Background="#2A3A58" Foreground="#35CFB7" BorderThickness="0" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="4" x:Name="DelayHintText"
                               Text="今晚还可以申请最后一次延迟，最长 30 分钟。"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />

                    <UniformGrid Grid.Row="6" x:Name="DelayButtonsPanel" Columns="4" Margin="-4,0">
                        <Button Style="{StaticResource DelayButton}" Tag="5" Click="Delay_Click">
                            <StackPanel><TextBlock Text="5" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="分钟" FontSize="10" FontWeight="Normal" HorizontalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource DelayButton}" Tag="10" Click="Delay_Click">
                            <StackPanel><TextBlock Text="10" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="分钟" FontSize="10" FontWeight="Normal" HorizontalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource DelayButton}" Tag="15" Click="Delay_Click">
                            <StackPanel><TextBlock Text="15" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="分钟" FontSize="10" FontWeight="Normal" HorizontalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource DelayButton}" Tag="30" Click="Delay_Click">
                            <StackPanel><TextBlock Text="30" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="分钟" FontSize="10" FontWeight="Normal" HorizontalAlignment="Center"/></StackPanel>
                        </Button>
                    </UniformGrid>

                    <Grid Grid.Row="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="请先保存正在处理的文件" Foreground="#94A3B8" FontSize="11.5"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                Content="知道了，按时休息" Click="Acknowledge_Click" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
