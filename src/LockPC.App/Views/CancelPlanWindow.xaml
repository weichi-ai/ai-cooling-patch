<Window x:Class="LockPC.App.Views.CancelPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="结束本次退烧计划"
        Width="470" Height="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FA">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadingText" Text="确定要结束本次退烧计划？" FontSize="22" FontWeight="SemiBold" Foreground="#101525" />
        <TextBlock x:Name="DescriptionText" Grid.Row="1" Text="提前结束需要写下理由。这不是检讨，只是帮未来的你看清哪些时刻最容易失控。" Margin="0,8,0,16" TextWrapping="Wrap" Foreground="#667085" />
        <Grid Grid.Row="2">
            <TextBox x:Name="ReasonTextBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="300" TextChanged="ReasonTextBox_TextChanged" />
            <TextBlock x:Name="PlaceholderText" Text="请认真写下原因，至少 5 个字" Foreground="#98A2B3" Margin="12,10" IsHitTestVisible="False" VerticalAlignment="Top" />
            <TextBlock x:Name="CountText" Text="0 / 至少 5 个字" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,8" Foreground="#FF7043" FontSize="12" />
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="KeepButton" Content="继续专注" Click="KeepPlan_Click" Margin="0,0,10,0" />
            <Button x:Name="ConfirmButton" Content="记录原因并结束" IsEnabled="False" Background="#FF7043" Foreground="White" BorderThickness="0" Click="ConfirmCancel_Click" />
        </StackPanel>
    </Grid>
</Window>
