<Window x:Class="LockPC.App.Views.LockTransitionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="540" Height="430"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual" Closing="Window_Closing">
    <Border x:Name="DialogSurface" CornerRadius="22" Padding="36,30,36,26"
            Background="#F21B4347" BorderBrush="#66FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.42" Color="#061013"/>
        </Border.Effect>
        <Grid TextBlock.Foreground="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="ModeText" Text="退烧贴准中" FontSize="14" Opacity="0.72"
                       HorizontalAlignment="Center"/>

            <Grid Grid.Row="1" Width="132" Height="132" Margin="0,16,0,16">
                <Ellipse Stroke="#38FFFFFF" StrokeThickness="7"/>
                <Ellipse x:Name="AnimatedRing" Stroke="#D9FFF8" StrokeThickness="7"
                         StrokeDashArray="13,5" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="RingRotate"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <TextBlock x:Name="CountdownText" Text="15" FontFamily="Consolas"
                           FontSize="58" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <ScaleTransform x:Name="NumberScale" ScaleX="1" ScaleY="1"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>

            <TextBlock Grid.Row="2" x:Name="TitleText" Text="即将进入休息退烧模式"
                       FontSize="23" FontWeight="SemiBold" TextAlignment="Center"/>
            <TextBlock Grid.Row="3" Text="建议手动保存重要资料" FontSize="15"
                       Opacity="0.82" HorizontalAlignment="Center" Margin="0,9,0,0"/>

            <WrapPanel Grid.Row="4" x:Name="DelayPanel" Visibility="Collapsed"
                       HorizontalAlignment="Center" Margin="0,18,0,0">
                <Button Content="延迟 5 分钟" Tag="5" Click="Delay_Click" Margin="0,0,7,7"
                        Background="#24FFFFFF" Foreground="White" BorderBrush="#58FFFFFF"/>
                <Button Content="延迟 10 分钟" Tag="10" Click="Delay_Click" Margin="0,0,7,7"
                        Background="#24FFFFFF" Foreground="White" BorderBrush="#58FFFFFF"/>
                <Button Content="延迟 15 分钟" Tag="15" Click="Delay_Click" Margin="0,0,7,7"
                        Background="#24FFFFFF" Foreground="White" BorderBrush="#58FFFFFF"/>
                <Button Content="延迟 30 分钟" Tag="30" Click="Delay_Click" Margin="0,0,0,7"
                        Background="#24FFFFFF" Foreground="White" BorderBrush="#58FFFFFF"/>
            </WrapPanel>

            <StackPanel Grid.Row="5" Margin="0,18,0,0">
                <ProgressBar x:Name="CountdownProgress" Height="6" Minimum="0" Maximum="15"
                             Value="15" BorderThickness="0" Foreground="#D9FFF8" Background="#30FFFFFF"/>
                <TextBlock Text="倒计时结束后自动进入锁屏，无需操作" FontSize="12"
                           Opacity="0.58" HorizontalAlignment="Center" Margin="0,11,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
