<Window x:Class="LockPC.App.Views.StartFocusPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认开始专注计划"
        Width="720" Height="500" MinWidth="560" MinHeight="420"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        SourceInitialized="Window_SourceInitialized"
        ShowInTaskbar="False"
        Background="{StaticResource PageBackground}">
    <Window.Resources>
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CFE5E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="126" />
            <Setter Property="Padding" Value="22,12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#B8C2C8" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="PrimaryDialogButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
    <Grid Margin="30,24,30,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="60" Height="60" CornerRadius="30" Background="{StaticResource PrimarySoftBrush}" VerticalAlignment="Top">
                <TextBlock Text="◷" FontSize="34" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="确认开始专注计划" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="准备好后，专注计时将立即开始" FontSize="15" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="PlanTitleText" Grid.Row="1" Text="2 轮专注计划" FontSize="26" FontWeight="SemiBold"
                   Foreground="#0A8F7D" HorizontalAlignment="Center" Margin="0,26,0,18" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="14" />
                <ColumnDefinition />
                <ColumnDefinition Width="14" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Text="◷" FontSize="25" Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="每轮专注" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,5" />
                    <TextBlock x:Name="FocusMinutesText" Text="50 分钟" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Text="☕" FontSize="23" Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="离屏休息" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,5" />
                    <TextBlock x:Name="RestMinutesText" Text="10 分钟" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Text="↻" FontSize="26" Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="计划轮数" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,5" />
                    <TextBlock x:Name="RoundsText" Text="2 轮" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#EEF1F3" CornerRadius="10" Padding="16,14" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="ⓘ" FontSize="19" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Text="专注期间可结束整组计划；休息期间可填写理由提前结束。"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="10,0,0,0" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="取消" IsCancel="True" Style="{StaticResource DialogButton}" Margin="0,0,12,0" Click="Cancel_Click" />
            <Button Content="开始专注" IsDefault="True" Style="{StaticResource PrimaryDialogButton}" Click="Start_Click" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
