<Window x:Class="LockPC.App.Views.LockOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" Cursor="Arrow"
        PreviewKeyDown="OnPreviewKeyDown" Deactivated="OnDeactivated" Closing="OnClosing">
    <Grid x:Name="Backdrop">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop x:Name="GradientStart" Color="#E879D9CC" Offset="0"/>
                <GradientStop x:Name="GradientEnd" Color="#F0114C51" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Ellipse Width="620" Height="300" Fill="#244FF2E4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-160,0,0,-100"/>
        <Ellipse Width="760" Height="360" Fill="#1830C9B5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-150,-180,0"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="760" Margin="40" TextBlock.Foreground="White">
            <TextBlock x:Name="KickerText" Text="退烧贴正在生效" FontSize="15" Opacity=".82" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TitleText" Text="离开屏幕，给大脑降降温。" FontSize="36" FontWeight="SemiBold" TextAlignment="Center" Margin="0,12,0,8" TextWrapping="Wrap"/>
            <TextBlock x:Name="DescriptionText" Text="本轮专注已经完成，休息结束后再回来。" FontSize="16" Opacity=".78" TextAlignment="Center"/>

            <Grid x:Name="CoolingPanel" Width="440" Height="190" Margin="0,28,0,8">
                <Border Width="390" Height="124" CornerRadius="25" Background="#D7FFFDF6" BorderBrush="#88FFFFFF" BorderThickness="2"
                        RenderTransformOrigin="0.5,0.5" x:Name="CoolingPatch">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="PatchScale" ScaleX="1" ScaleY="1"/>
                            <RotateTransform x:Name="PatchRotate" Angle="0"/>
                            <TranslateTransform x:Name="PatchTranslate" X="0" Y="0"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Grid>
                        <Border Margin="10" CornerRadius="18" BorderBrush="#5822BFA9" BorderThickness="1"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="AI 退烧贴" Foreground="#0F766E" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CoolingPercentText" Text="正在降温 0%" Foreground="#188A80" FontSize="13" Margin="0,7,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Path x:Name="PatchFold" Data="M 0,36 L 36,0 L 36,36 Z" Fill="#F4FFFFFF" Stroke="#6622BFA9" Stretch="Fill" Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0"/>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock x:Name="CountdownText" Text="10:00" FontSize="66" FontWeight="SemiBold" FontFamily="Consolas" HorizontalAlignment="Center"/>
            <ProgressBar x:Name="CoolingProgress" Width="390" Height="7" Minimum="0" Maximum="100" Value="0" Margin="0,8,0,0" Foreground="#C8FFF8" Background="#35FFFFFF" BorderThickness="0"/>
            <TextBlock x:Name="FooterText" Text="距离下一轮专注还有" FontSize="14" Opacity=".72" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <Button x:Name="EarlyEndButton" Content="提前撕贴" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,24,0,0"
                    Background="#30FFFFFF" Foreground="White" BorderBrush="#66FFFFFF" Click="EarlyEndButton_Click"/>
        </StackPanel>
    </Grid>
</Window>